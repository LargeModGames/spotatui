{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotatui-desktop",
  "mainBinaryName": "spotatui-desktop",
  "identifier": "com.largemodgames.spotatui",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMkVFQzYyMzQ5MjgwOEEKUldTS2dKSTBZdXd1Y1YwUjJDWFpoL3R5ZURCS21OZkdTVTNhZjVCWmVmT3UrR1NhbUF3SGlCaDAK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/LargeModGames/spotatui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "Music",
    "shortDescription": "Music player for Spotify and more",
    "longDescription": "spotatui desktop: a music player for Spotify with native streaming, plus local files, Subsonic, internet radio, YouTube and Qobuz, and Apple Music on macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libssl3"]
      },
      "rpm": {
        "depends": ["alsa-lib", "openssl-libs"]
      }
    }
  }
}
